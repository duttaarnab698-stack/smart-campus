# Copy to .env and supply values privately. Never commit a populated .env file.
APP_ENV=development
SIMULATION_MODE=true
CAMPUS_DATABASE_PATH=campus_pulse.db

# Supabase (server-side only; use a service-role key only in the backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# HiveMQ Cloud (TLS is required for port 8883)
MQTT_BROKER_URL=your-cluster.s1.eu.hivemq.cloud
MQTT_BROKER_PORT=8883
MQTT_BROKER_USERNAME=replace-with-mqtt-username
MQTT_BROKER_PASSWORD=replace-with-mqtt-password
MQTT_TLS_ENABLED=true

# Device/API security
DEVICE_AUTH_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=https://smart-campus-red.vercel.app,http://127.0.0.1:5500,http://localhost:5500

# Automation and energy settings
MAX_COMMAND_RETRIES=3
COMMAND_TIMEOUT_SECONDS=5
TELEMETRY_FRESHNESS_SECONDS=60
EMPTY_ROOM_SHUTDOWN_DELAY_SECONDS=5
EMPTY_ROOM_POWER_THRESHOLD_KW=0.05
ELECTRICITY_RATE_PER_KWH=8
CO2_KG_PER_KWH=0.417
